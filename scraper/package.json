{
  "name": "cesta-lista-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Descarga diaria de precios de Mercadona y Consum para Cesta Lista",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "scrape": "node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "estado": "node src/comprobar-meta.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
