.env
*.local.json
cesta-lista-copia*.json

# Archivos temporales del scraper (se escriben y se renombran)
data/**/*.tmp

# Configuración local de Claude Code (contiene rutas de este Mac)
.claude/

# Documentos personales (dietas en PDF): nunca al repositorio público.
*.pdf
!app/test/fixtures/dieta-inventada.pdf
